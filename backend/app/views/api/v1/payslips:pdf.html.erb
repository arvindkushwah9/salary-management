<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">

  <style>
    body {
      font-family: Arial, sans-serif;
      color: #1e293b;
      font-size: 13px;
      margin: 30px;
    }

    .header {
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 20px;
      margin-bottom: 25px;
    }

    .company {
      font-size: 24px;
      font-weight: bold;
    }

    .title {
      font-size: 20px;
      font-weight: bold;
      margin-top: 20px;
    }

    .employee {
      margin: 20px 0;
      padding: 18px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
    }

    .employee-name {
      font-size: 18px;
      font-weight: bold;
    }

    .meta {
      color: #64748b;
      margin-top: 5px;
    }

    .summary {
      width: 100%;
      margin-bottom: 25px;
    }

    .summary td {
      width: 25%;
      padding: 12px;
      border: 1px solid #e2e8f0;
    }

    .label {
      color: #64748b;
      font-size: 11px;
      text-transform: uppercase;
    }

    .value {
      font-size: 17px;
      font-weight: bold;
      margin-top: 5px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th {
      background: #f8fafc;
      text-align: left;
      padding: 10px;
      border-bottom: 1px solid #cbd5e1;
    }

    td {
      padding: 10px;
      border-bottom: 1px solid #e2e8f0;
    }

    .amount {
      text-align: right;
    }

    .net-pay {
      margin-top: 25px;
      padding: 18px;
      background: #f8fafc;
      text-align: right;
      font-size: 20px;
      font-weight: bold;
    }

    .footer {
      margin-top: 40px;
      color: #64748b;
      font-size: 10px;
      text-align: center;
    }
  </style>
</head>

<body>

  <div class="header">
    <div class="company">SalaryHub</div>
    <div class="title">Payslip</div>
  </div>

  <div class="employee">
    <div class="employee-name">
      <%= payslip.employee.full_name %>
    </div>

    <div class="meta">
      <%= payslip.employee.employee_code %>
      ·
      <%= payslip.employee.email %>
    </div>

    <div class="meta">
      Payroll Period:
      <%= payslip.payroll_run.payroll_period %>
      ·
      Currency:
      <%= payslip.payroll_run.currency %>
    </div>
  </div>

  <table class="summary">
    <tr>
      <td>
        <div class="label">Working Days</div>
        <div class="value">
          <%= payslip.working_days %>
        </div>
      </td>

      <td>
        <div class="label">Paid Days</div>
        <div class="value">
          <%= payslip.paid_days %>
        </div>
      </td>

      <td>
        <div class="label">Gross Earnings</div>
        <div class="value">
          <%= number_to_currency(
                payslip.gross_earnings,
                unit: payslip.payroll_run.currency
              ) %>
        </div>
      </td>

      <td>
        <div class="label">Net Pay</div>
        <div class="value">
          <%= number_to_currency(
                payslip.net_pay,
                unit: payslip.payroll_run.currency
              ) %>
        </div>
      </td>
    </tr>
  </table>

  <h3>Earnings & Deductions</h3>

  <table>
    <thead>
      <tr>
        <th>Code</th>
        <th>Description</th>
        <th>Type</th>
        <th class="amount">Amount</th>
      </tr>
    </thead>

    <tbody>
      <% payslip.payslip_items.each do |item| %>
        <tr>
          <td><%= item.code %></td>
          <td><%= item.description %></td>
          <td><%= item.item_type.titleize %></td>
          <td class="amount">
            <%= number_to_currency(
                  item.amount,
                  unit: payslip.payroll_run.currency
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="net-pay">
    Net Pay:
    <%= number_to_currency(
          payslip.net_pay,
          unit: payslip.payroll_run.currency
        ) %>
  </div>

  <div class="footer">
    Generated by SalaryHub
  </div>

</body>
</html>